---
const principles = [
  { title: 'Clarity before complexity', tone: 'cyan' },
  { title: 'Design with intention', tone: 'azure' },
  { title: 'Technology for people', tone: 'violet' },
  { title: 'Built to keep improving', tone: 'pink' },
];
---

<section class="section" id="about">
  <div class="container about">
    <div class="about__intro" data-reveal>
      <p class="kicker">Who we are</p>
      <h2>Make the complicated feel considered.</h2>
    </div>

    <div class="about__text" data-reveal>
      <p>
        ViVia is a small digital studio for people who want technology to feel clearer, more
        useful, and more human.
      </p>
      <p>
        We look beyond the surface of a product. From a safer website to a more accessible piece
        of hardware, we ask what makes an experience valuable, dependable, and worth returning to.
      </p>
    </div>

    <ol class="principles">
      {
        principles.map(({ title, tone }, i) => (
          <li class:list={['principle', 'card', 'spot', `principle--${tone}`]} data-reveal>
            <svg class="principle__icon" viewBox="0 0 80 80" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              {i === 0 && (
                <>
                  <g class="i-dots" fill="currentColor" stroke="none">
                    <circle cx="10" cy="26" r="2.4" /><circle cx="20" cy="16" r="1.8" /><circle cx="17" cy="33" r="2.8" />
                    <circle cx="8" cy="42" r="1.8" /><circle cx="19" cy="48" r="2.4" /><circle cx="11" cy="58" r="2.6" />
                    <circle cx="23" cy="62" r="1.8" /><circle cx="28" cy="24" r="1.8" /><circle cx="30" cy="54" r="1.8" />
                  </g>
                  <path d="M34 28c8 2 12 7 24 8M32 40h26M34 52c8-2 12-7 24-8" />
                  <path d="M52 22v12M52 46v12M52 22l22 18-22 18" />
                </>
              )}
              {i === 1 && (
                <>
                  <g class="i-brackets">
                    <path d="M12 24V12h12M56 12h12v12M68 56v12H56M24 68H12V56" />
                  </g>
                  <circle cx="40" cy="40" r="18" />
                  <circle cx="40" cy="40" r="3" />
                </>
              )}
              {i === 2 && (
                <>
                  <path d="M12 62c-4-7-6-14-6-22C6 25 17 13 30 13c12 0 21 9 21 21 0 3 1 5 4 9l-4 2v9c0 3-2 5-5 5h-6" />
                  <path class="i-wave" d="M24 66h10l4-10 6 18 5-12 3 4h18" pathLength="1" />
                </>
              )}
              {i === 3 && (
                <>
                  <path class="i-bar" d="M12 68V50h14v18z" />
                  <path class="i-bar" d="M33 68V38h14v30z" />
                  <path class="i-bar" d="M54 68V28h14v40z" />
                  <path class="i-arrow" d="M61 21V8M52 16l9-9 9 9" />
                </>
              )}
            </svg>
            <span class="principle__index">0{i + 1}</span>
            <h3>{title}</h3>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .about {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    gap: clamp(2rem, 5vw, 4.5rem) clamp(2rem, 6vw, 6rem);
    align-items: end;
  }

  .about__text {
    display: grid;
    gap: 1rem;
    font-size: 1.0625rem;
  }

  .principles {
    display: grid;
    grid-column: 1 / -1;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1rem;
  }

  .principle {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: start;
    gap: 2.5rem 1rem;
    padding: 1.5rem;
  }

  .principle h3 {
    grid-column: 1 / -1;
    font-size: 1.1875rem;
    font-weight: 500;
    line-height: 1.25;
  }

  .principle__index {
    color: var(--text-3);
    font: 400 var(--fs-label)/1 var(--mono);
  }

  .principle__icon {
    width: 4rem;
    height: 4rem;
    overflow: visible;
  }

  .principle--cyan { color: var(--cyan); }
  .principle--azure { color: #5aa8ff; }
  .principle--violet { color: #a78df5; }
  .principle--pink { color: var(--pink); }

  .i-dots,
  .i-brackets,
  .i-bar,
  .i-arrow {
    transition: transform 0.5s var(--ease);
    transform-box: fill-box;
    transform-origin: center;
  }

  .i-bar {
    transform-origin: bottom;
  }

  .principle:hover .i-dots { transform: translateX(6px); }
  .principle:hover .i-brackets { transform: scale(0.88); }
  .principle:hover .i-bar { transform: scaleY(1.08); }
  .principle:hover .i-arrow { transform: translateY(-4px); }

  .principle:hover .i-wave {
    stroke-dasharray: 1;
    animation: wave 1s ease;
  }

  @keyframes wave {
    from { stroke-dashoffset: 1; }
    to { stroke-dashoffset: 0; }
  }

  @media (max-width: 960px) {
    .about {
      grid-template-columns: minmax(0, 1fr);
    }

    .principles {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 480px) {
    .principle {
      gap: 1.75rem 1rem;
      padding: 1.25rem;
    }

    .principle h3 {
      font-size: 1.0625rem;
    }
  }
</style>
