---
import { generateCover } from '../lib/cover';
import { uid } from '../lib/uid';

interface Props {
  slug: string;
  class?: string;
  /** Leaves the middle clear for a logo placed on top. */
  behindLogo?: boolean;
}

const { slug, class: className, behindLogo = false } = Astro.props;
const cover = generateCover(slug, behindLogo);
const stroke = uid('cover');
const glow = uid('glow');
---

<svg
  class:list={['cover', className]}
  viewBox={`0 0 ${cover.width} ${cover.height}`}
  preserveAspectRatio="xMidYMid slice"
  aria-hidden="true"
  focusable="false"
>
  <defs>
    <linearGradient id={stroke} gradientUnits="userSpaceOnUse" {...cover.gradient}>
      <stop offset="0" stop-color="#00f5eb"></stop>
      <stop offset=".36" stop-color="#2a8cff"></stop>
      <stop offset=".66" stop-color="#8a6cf0"></stop>
      <stop offset="1" stop-color="#f56edb"></stop>
    </linearGradient>
    <radialGradient id={glow} gradientUnits="userSpaceOnUse" cx={cover.focus.x} cy={cover.focus.y} r="460">
      <stop offset="0" stop-color="#2a4fd0" stop-opacity=".5"></stop>
      <stop offset="1" stop-color="#2a4fd0" stop-opacity="0"></stop>
    </radialGradient>
  </defs>
  <rect width={cover.width} height={cover.height} fill="#090c15"></rect>
  <rect width={cover.width} height={cover.height} fill={`url(#${glow})`}></rect>
  <path d={cover.bottom} fill="none" stroke={`url(#${stroke})`} stroke-width="1.5" stroke-dasharray="4 8" opacity=".4"></path>
  <path d={cover.top} fill="none" stroke={`url(#${stroke})`} stroke-width="2" stroke-linejoin="round" opacity=".8"></path>
  <path d={cover.vias} fill="#090c15" stroke={`url(#${stroke})`} stroke-width="2"></path>
  <path d={cover.pads} fill={`url(#${stroke})`}></path>
  {
    !behindLogo && (
      <>
        <circle cx={cover.focus.x} cy={cover.focus.y} r="88" fill="#0b0f1a" stroke={`url(#${stroke})`} stroke-width="5" />
        <circle cx={cover.focus.x} cy={cover.focus.y} r="62" fill="none" stroke={`url(#${stroke})`} stroke-width="2" opacity=".45" />
      </>
    )
  }
</svg>

<style>
  .cover {
    width: 100%;
    height: 100%;
    max-width: none;
  }
</style>
