---
import { Picture } from 'astro:assets';
import type { Post } from '../lib/journal';
import Cover from './Cover.astro';

interface Props {
  post: Post;
  widths: number[];
  sizes: string;
  /** The cover at the top of an article. Cards sit beside their title, so theirs is decorative. */
  lead?: boolean;
}

const { post, widths, sizes, lead = false } = Astro.props;
const { cover, coverAlt, coverFit } = post.data;
const isLogo = cover !== undefined && coverFit === 'contain';
const alt = lead ? (coverAlt ?? '') : '';
const loading = lead ? 'eager' : 'lazy';
---

<div class="post-cover">
  {(!cover || isLogo) && <Cover slug={post.id} behindLogo={isLogo} />}
  {
    cover &&
      (isLogo ? (
        <Picture class="post-cover__logo" src={cover} alt={alt} formats={['avif', 'webp']} fallbackFormat="png" loading={loading} />
      ) : (
        <Picture class="post-cover__photo" src={cover} alt={alt} formats={['avif', 'webp']} widths={widths} sizes={sizes} loading={loading} />
      ))
  }
</div>

<style>
  .post-cover {
    position: relative;
    width: 100%;
    height: 100%;
  }

  .post-cover :global(.post-cover__photo) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* Takes the edge off bright photos on the dark page. */
    filter: brightness(0.9);
  }

  .post-cover :global(.post-cover__logo) {
    position: absolute;
    top: 50%;
    left: 50%;
    width: auto;
    height: 64%;
    filter: drop-shadow(0 14px 34px rgb(0 0 0 / 0.55));
    translate: -50% -50%;
  }
</style>
